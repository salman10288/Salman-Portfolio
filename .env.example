# Public site URL used for metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub activity. GITHUB_TOKEN is optional but improves API rate limits.
GITHUB_USERNAME=
GITHUB_TOKEN=

# Optional automatic contact delivery through Resend.
# When these are left empty, the contact form opens a prefilled email instead.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=its.salmansaeed07@gmail.com
